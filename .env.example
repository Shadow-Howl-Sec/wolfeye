# ──────────────────────────────────────────────
#  WolfEye — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git.
# ──────────────────────────────────────────────

# Flask
FLASK_ENV=development         # development | production
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Dev: leave blank (SQLite used automatically)
# Prod: set to your Supabase PostgreSQL connection string
DATABASE_URL=

# Threat Intelligence API Keys
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
THREATFOX_API_KEY=

# Optional host-agent token for POST /api/observations. Leave blank to require admin session.
LOCAL_INGEST_TOKEN=

# Optional community intelligence integrations
MISP_URL=
MISP_KEY=
MISP_VERIFY_SSL=true
OPENCTI_URL=
OPENCTI_TOKEN=

# Email alerts (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Demo account credentials (read-only public login)
DEMO_USERNAME=demo
DEMO_PASSWORD=wolfeye-demo

# Admin account credentials (full write access)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Rate limiting (requests per minute per IP)
RATELIMIT_DEFAULT=60

# Alerting / scoring thresholds
ALERT_MIN_SCORE=0.60
ALERT_SEVERITY_LOW=0.60
ALERT_SEVERITY_MEDIUM=0.70
ALERT_SEVERITY_HIGH=0.80
ALERT_SEVERITY_CRITICAL=0.90

# Optional flow-model operating mode (shadow|advisory)
FLOW_MODEL_MODE=shadow
FLOW_ALERT_CONFIDENCE=0.90
AUTO_BLOCK_ON_CRITICAL_IOC_MATCH=false
